    "react": ">=19",
    "three": ">=0.160"
  },
  "devDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.0",
    "@types/react": "^19.0.0",
    "@types/three": "^0.171.0",
    "react": "^19.0.0",
    "three": "^0.171.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
