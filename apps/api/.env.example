# Copy to .env (git-ignored) and fill in a real key to enable photo-room import.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PORT=8787

# Skip OpenAI entirely and return a canned proposal — for local development/testing
# the import UI without spending real API credits. Never used unless explicitly set.
ROOM_PHOTO_MOCK=false

# --- Light study: optional photoreal re-lighting of a captured frame ---
# The accurate day cycle is rendered client-side and needs none of this; these only
# enable the styling pass. Reuses OPENAI_API_KEY above.
OPENAI_IMAGE_MODEL=gpt-image-1
# Echo the submitted frame back instead of calling the image model — exercises the
# whole round trip for free during development.
LIGHT_STUDY_MOCK=false

# --- Image Generation Day: a real room photo re-lit across that day's real sun ---
# Same deal: echoes the uploaded photo back instead of calling the image model, so the
# whole twelve-moment flow is clickable with no key and no billing.
IMAGE_DAY_MOCK=false

# --- Deployment (leave unset for local dev) ---
# Read deploy/SECURITY.md before pointing a public URL at this. The short version:
# SESSION_SECRET=$(openssl rand -base64 48)   signs the ownership cookie
# NODE_ENV=production                         secure cookies, HSTS, no localhost CORS
# TRUST_PROXY=1                               hop count, or rate limits are one bucket
# VITE_ORIGIN=https://your.app                the CORS allowlist
# IMAGE_DAILY_MAX=50                          hard daily ceiling on billed image calls
