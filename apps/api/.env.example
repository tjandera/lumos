# Copy to .env (git-ignored) and fill in a real key to enable photo-room import.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PORT=8787

# Skip OpenAI entirely and return a canned proposal — for local development/testing
# the import UI without spending real API credits. Never used unless explicitly set.
ROOM_PHOTO_MOCK=false

# --- Light study: optional photoreal re-lighting of a captured frame ---
# The accurate day cycle is rendered client-side and needs none of this; these only
# enable the styling pass. Reuses OPENAI_API_KEY above.
OPENAI_IMAGE_MODEL=gpt-image-1
# Echo the submitted frame back instead of calling the image model — exercises the
# whole round trip for free during development.
LIGHT_STUDY_MOCK=false
