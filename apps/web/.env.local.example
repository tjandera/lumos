# Copy to .env.local (gitignored) and adjust as needed.

# AI assistant drawer — on by default even without this file; set to false to hide it.
VITE_FEATURE_AI=true

# Photo-based room import — opt-in, off by default.
VITE_FEATURE_ROOM_PHOTO=false

# Base URL for apps/api, used by the (dead-lineage) fetch-based AI client and photo
# import — irrelevant to the live client-side AI panel, which never calls a backend.
# VITE_API_URL=http://localhost:8787
